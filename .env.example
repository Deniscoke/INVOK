# ----------------------------------------------------------------------------
# INVOk – example environment file.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# This file must contain ONLY empty placeholders — no real secrets.
#
# Naming rule (Vite): only variables prefixed with `VITE_` are exposed to the
# browser bundle. Everything else stays server-only (Vercel Functions).
# ----------------------------------------------------------------------------

# --- Public (safe to ship to the frontend) ---------------------------------
VITE_APP_ENV=development
VITE_PUBLIC_BASE_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only secrets (MUST NOT be exposed to the frontend) -------------
# The service role key bypasses Row Level Security. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI AI validation (server-only) ------------------------------------
# OPENAI_API_KEY is server-only. NEVER commit a real value or expose it to the frontend.
OPENAI_API_KEY=
OPENAI_VALIDATION_MODEL=gpt-5.5
# Provider switch: 'mock' (default, no API calls) or 'openai' (real OpenAI).
# 'openai' is only used when OPENAI_API_KEY is also set.
OPENAI_VALIDATION_PROVIDER=mock
OPENAI_VALIDATION_TIMEOUT_MS=15000
# Raw prompt logging is OFF by default (privacy). Only enable for debugging.
OPENAI_VALIDATION_LOG_RAW_PROMPTS=false

# --- Limits / safety knobs --------------------------------------------------
MAX_UPLOAD_MB=8
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30

# --- AI rate limiting & cost guard (MVP, in-memory — not secret) ------------
# Per-window request caps (per identity). Students stricter than teachers.
AI_RATE_LIMIT_WINDOW_MS=60000
AI_RATE_LIMIT_MAX_PER_STUDENT=5
AI_RATE_LIMIT_MAX_PER_TEACHER=20
# Rolling 24h caps (in-memory MVP; production: Redis/Upstash or Supabase-backed).
AI_DAILY_MAX_PER_STUDENT=30
AI_DAILY_MAX_PER_CLASS=300
# Evidence length cost guard (chars sent to the model).
AI_MAX_EVIDENCE_CHARS=5000
AI_MIN_EVIDENCE_CHARS=20
