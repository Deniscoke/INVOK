# ----------------------------------------------------------------------------
# INVOk – example environment file.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
#
# Naming rule (Vite): only variables prefixed with `VITE_` are exposed to the
# browser bundle. Everything else stays server-only (Vercel Functions).
# ----------------------------------------------------------------------------

# --- Public (safe to ship to the frontend) ---------------------------------
VITE_APP_ENV=development
VITE_PUBLIC_BASE_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only secrets (MUST NOT be exposed to the frontend) -------------
# The service role key bypasses Row Level Security. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic key for AI validation. Server-side only. NEVER commit a real value.
ANTHROPIC_API_KEY=
AI_VALIDATION_MODEL=claude-sonnet-4-5
# Provider switch: 'mock' (default, no API calls) or 'anthropic' (real Claude).
# 'anthropic' is only used when ANTHROPIC_API_KEY is also set.
AI_VALIDATION_PROVIDER=mock
AI_VALIDATION_TIMEOUT_MS=15000
# Raw prompt logging is OFF by default (privacy). Only enable for debugging.
AI_VALIDATION_LOG_RAW_PROMPTS=false

# --- Limits / safety knobs --------------------------------------------------
MAX_UPLOAD_MB=8
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
