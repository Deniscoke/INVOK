# ----------------------------------------------------------------------------
# INVOk – example environment file.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
#
# Naming rule (Vite): only variables prefixed with `VITE_` are exposed to the
# browser bundle. Everything else stays server-only (Vercel Functions).
# ----------------------------------------------------------------------------

# --- Public (safe to ship to the frontend) ---------------------------------
VITE_APP_ENV=development
VITE_PUBLIC_BASE_URL=http://localhost:5173
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server-only secrets (MUST NOT be exposed to the frontend) -------------
# The service role key bypasses Row Level Security. Server-side only.
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic key for future AI validation. Server-side only.
ANTHROPIC_API_KEY=
AI_VALIDATION_MODEL=claude-sonnet-4-6

# --- Limits / safety knobs --------------------------------------------------
MAX_UPLOAD_MB=8
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
